VITE_CONSTRUCTION_DISABLED=
VITE_API_BASE_URL=

# --- OIDC (shared homelab Logto) ---
# Leave all blank for the default dev profile (local JWT via /api/dev/login).
# All values are public (no secrets).
# dev-oidc and prod: https://auth.akandiah.ca/oidc
VITE_OIDC_AUTHORITY=
# Client ID of the Logto SPA app: prop-mange-dev for dev-oidc, the prod app for prod
VITE_OIDC_CLIENT_ID=
# Must match a redirect URI registered on that Logto app exactly
# dev-oidc: http://localhost:3000/auth/callback
# prod:     https://<UI_DOMAIN>/auth/callback
VITE_OIDC_REDIRECT_URI=
# Logto API resource identifier; must equal the backend's AUTH_AUDIENCE (dev and prod differ).
# Without it Logto issues an opaque token and the backend rejects it.
VITE_OIDC_RESOURCE=

# Optional: enable persistence (offline outbox) in dev for testing reload-after-offline
# VITE_PERSIST_OFFLINE=true

# Optional
# VITE_QUERY_CACHE_MAX_AGE_HOURS=
# VITE_QUERY_CACHE_GC_TIME_MS=
# VITE_QUERY_CACHE_STALE_TIME_MS=

# Optional: TTL for synced mutation rows in IndexedDB, ms (default: 7 days)
# VITE_MUTATION_OUTBOX_MAX_AGE_DAYS=

# Optional: delay (ms) before showing skeleton/spinner; avoids flash on fast loads (default: 250)
# VITE_LOADING_FALLBACK_DELAY_MS=
