VITE_CONSTRUCTION_DISABLED=
VITE_API_BASE_URL=

# --- OIDC (Authentik) ---
# authority: https://<API_DOMAIN>/application/o/<provider-slug>/
VITE_OIDC_AUTHORITY=
# client_id from Authentik OAuth2 Provider settings
VITE_OIDC_CLIENT_ID=
# Must match redirect URI registered in Authentik exactly
VITE_OIDC_REDIRECT_URI=https://propmanager.pages.dev/auth/callback

# Optional: enable persistence (offline outbox) in dev for testing reload-after-offline
# VITE_PERSIST_OFFLINE=true

# Optional
# VITE_QUERY_CACHE_MAX_AGE_HOURS=
# VITE_QUERY_CACHE_GC_TIME_MS=
# VITE_QUERY_CACHE_STALE_TIME_MS=

# Optional: TTL for synced mutation rows in IndexedDB, ms (default: 7 days)
# VITE_MUTATION_OUTBOX_MAX_AGE_DAYS=

# Optional: delay (ms) before showing skeleton/spinner; avoids flash on fast loads (default: 250)
# VITE_LOADING_FALLBACK_DELAY_MS=
